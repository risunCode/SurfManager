<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documentation | SurfManager - Reset IDE data, Backup & Restore</title>
    <meta name="description"
        content="Complete documentation for SurfManager. Reset IDE data, create backup and restore, manage multi-account easily. Work for VS-Code/fork based app like Cursor, Windsurf.">
    <meta name="keywords"
        content="cursor, reset-trial, agentic, agentic-ai, cursor-pro, cursor-ai, free-trial-reset, cursor-reset, windsurf-reset, reset-cursor, reset-windsurf, surfmanager, milkforge-pro, documentation, user guide">
    <meta name="author" content="risunCode">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://github.com/risunCode/SurfManager">
    <meta property="og:title" content="SurfManager Documentation - Complete User Guide">
    <meta property="og:description"
        content="Complete documentation for SurfManager. Reset IDE data, create backup and restore, manage multi-account easily.">
    <meta property="og:image"
        content="https://raw.githubusercontent.com/risunCode/SurfManager/main/web/assets/images/v1.jpg">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://github.com/risunCode/SurfManager">
    <meta property="twitter:title" content="SurfManager Documentation - Complete User Guide">
    <meta property="twitter:description"
        content="Complete documentation for SurfManager. Reset IDE data, create backup and restore, manage multi-account easily.">
    <meta property="twitter:image"
        content="https://raw.githubusercontent.com/risunCode/SurfManager/main/web/assets/images/v1.jpg">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom Tailwind Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        terminal: {
                            bg: '#0a0e27',
                            dark: '#050810',
                            border: '#1a1f3a',
                            green: '#00ff41',
                            cyan: '#00d4ff',
                            gray: '#8b949e',
                        }
                    },
                    fontFamily: {
                        mono: ['Courier New', 'monospace'],
                    }
                }
            }
        }
    </script>

    <style>
        @keyframes blink {
            0%,
            50% {
                opacity: 1;
            }

            51%,
            100% {
                opacity: 0;
            }
        }

        .cursor-blink::after {
            content: '▋';
            animation: blink 1s infinite;
            color: #00ff41;
        }

        .terminal-text {
            text-shadow: 0 0 5px rgba(0, 255, 65, 0.5);
        }

        .glow-border {
            box-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        }

        .glow-border:hover {
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.5);
        }

        #matrix-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            opacity: 0.12;
        }

        /* Fixed Sidebar - Won't be overlapped by footer */
        .sidebar-fixed {
            position: fixed;
            left: 2rem;
            top: 100px;
            width: 16rem;
            max-height: calc(100vh - 120px);
            overflow-y: auto;
            z-index: 40;
        }

        @media (max-width: 1280px) {
            .sidebar-fixed {
                display: none;
            }
        }

        .main-content {
            margin-left: 20rem;
        }

        @media (max-width: 1280px) {
            .main-content {
                margin-left: 0;
            }
        }

        #toc-nav a {
            display: block;
            padding: 0.5rem 1rem;
            color: #8b949e;
            text-decoration: none;
            border-left: 2px solid transparent;
            transition: all 0.2s;
            font-size: 0.875rem;
        }

        #toc-nav a:hover {
            color: #00ff41;
            border-left-color: #00ff41;
            background: rgba(0, 255, 65, 0.05);
        }

        #toc-nav a.active {
            color: #00d4ff;
            border-left-color: #00d4ff;
            background: rgba(0, 212, 255, 0.1);
            font-weight: bold;
        }

        #toc-nav a.level-2 {
            padding-left: 1.5rem;
            font-size: 0.8125rem;
        }

        #toc-nav a.level-3 {
            padding-left: 2rem;
            font-size: 0.75rem;
        }

        #markdown-content h1 {
            font-size: 2.5rem;
            font-weight: bold;
            color: #00ff41;
            margin: 2rem 0 1rem;
            text-shadow: 0 0 10px rgba(0, 255, 65, 0.3);
        }

        #markdown-content h2 {
            font-size: 2rem;
            font-weight: bold;
            color: #00ff41;
            margin: 2rem 0 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #1a1f3a;
        }

        #markdown-content h3 {
            font-size: 1.5rem;
            font-weight: bold;
            color: #00d4ff;
            margin: 1.5rem 0 0.75rem;
        }

        #markdown-content p {
            color: #8b949e;
            line-height: 1.75;
            margin-bottom: 1rem;
        }

        #markdown-content ul,
        #markdown-content ol {
            margin-bottom: 1rem;
            padding-left: 2rem;
        }

        #markdown-content li {
            color: #8b949e;
            margin-bottom: 0.5rem;
        }

        #markdown-content code {
            background: #0a0e27;
            border: 1px solid #1a1f3a;
            color: #00ff41;
            padding: 0.125rem 0.375rem;
            border-radius: 0.25rem;
            font-size: 0.875rem;
        }

        #markdown-content pre {
            background: #0a0e27;
            border: 1px solid #1a1f3a;
            padding: 1rem;
            border-radius: 0.25rem;
            overflow-x: auto;
            margin-bottom: 1rem;
        }

        #markdown-content pre code {
            background: none;
            border: none;
            padding: 0;
        }

        #markdown-content a {
            color: #00d4ff;
            text-decoration: underline;
        }

        #markdown-content a:hover {
            color: #00ff41;
        }

        #markdown-content img {
            max-width: 100%;
            height: auto;
            border: 2px solid #1a1f3a;
            margin: 1.5rem 0;
        }

        #markdown-content hr {
            border: none;
            border-top: 2px solid #1a1f3a;
            margin: 2rem 0;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #050810;
        }

        ::-webkit-scrollbar-thumb {
            background: #1a1f3a;
            border-left: 2px solid #00ff41;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #00ff41;
        }
    </style>
</head>

<body class="bg-terminal-dark text-terminal-gray">

    <canvas id="matrix-canvas"></canvas>

    <nav class="fixed top-0 left-0 right-0 z-50 bg-terminal-bg/95 backdrop-blur-sm border-b border-terminal-border">
        <div class="max-w-7xl mx-auto px-4 h-16 flex justify-between items-center">
            <a href="index.html" class="flex items-center space-x-3">
                <span class="text-2xl text-terminal-green">❯</span>
                <span class="text-xl font-bold text-terminal-green terminal-text">SURFMANAGER</span>
                <span class="text-xs text-terminal-cyan border border-terminal-cyan px-2 py-1">v5.1.2</span>
            </a>
            <div class="flex items-center space-x-6">
                <a href="index.html#home" class="text-terminal-gray hover:text-terminal-green transition-colors">[ HOME
                    ]</a>
                <a href="index.html#features" class="text-terminal-gray hover:text-terminal-green transition-colors">[
                    FEATURES ]</a>
                <a href="docs.html" class="text-terminal-green">[ DOCS ]</a>
                <a href="https://github.com/risunCode/SurfManager" target="_blank"
                    class="bg-terminal-green text-terminal-dark px-4 py-2 hover:bg-terminal-cyan transition-all glow-border">DOWNLOAD</a>
            </div>
        </div>
    </nav>

    <div class="pt-20 relative z-10">

        <!-- Fixed Sidebar - z-index 40 so it stays above footer -->
        <aside class="sidebar-fixed">
            <div class="border border-terminal-border bg-terminal-bg/80 backdrop-blur-sm p-4">
                <div class="text-sm font-bold text-terminal-cyan mb-4">[ TABLE OF CONTENTS ]</div>
                <nav id="toc-nav"></nav>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="main-content px-4 py-8 max-w-4xl">

            <div class="mb-8">
                <h1 class="text-4xl font-bold text-terminal-green terminal-text mb-2">❯ DOCUMENTATION_</h1>
                <p class="text-terminal-cyan">// Live from GitHub README</p>
            </div>

            <div id="loading-state" class="border border-terminal-border bg-terminal-bg/80 p-12 text-center">
                <div class="text-terminal-green text-xl mb-3 animate-pulse">[ LOADING DOCUMENTATION ]</div>
                <div class="text-terminal-gray">Fetching from GitHub...</div>
            </div>

            <div id="error-state" class="hidden border border-red-500 bg-terminal-bg/80 p-12 text-center">
                <div class="text-red-500 text-xl mb-3">[ ERROR ]</div>
                <div class="text-terminal-gray mb-6">Failed to load from GitHub</div>
                <a href="https://raw.githubusercontent.com/risunCode/SurfManager/refs/heads/main/README.md"
                    target="_blank"
                    class="inline-block bg-terminal-green text-terminal-dark px-6 py-3 hover:bg-terminal-cyan transition-all glow-border">VIEW
                    RAW</a>
            </div>

            <div id="docs-container" class="hidden">
                <div class="border border-terminal-border bg-terminal-bg/80">
                    <div
                        class="bg-terminal-border px-6 py-3 border-b border-terminal-border flex justify-between items-center">
                        <span class="text-xs text-terminal-gray"><span class="text-terminal-green">❯</span>
                            README.md</span>
                        <a href="https://github.com/risunCode/SurfManager/blob/main/README.md" target="_blank"
                            class="text-xs text-terminal-green hover:text-terminal-cyan">[ GitHub → ]</a>
                    </div>
                    <div id="markdown-content" class="p-8"></div>
                </div>
            </div>

        </div>
    </div>

    <footer class="border-t border-terminal-border bg-terminal-bg py-8 px-4 relative z-10 mt-20">
        <div class="max-w-7xl mx-auto text-center">
            <p class="text-terminal-gray text-sm">© 2025 SurfManager | MIT License | <a
                    href="https://github.com/risunCode"
                    class="text-terminal-green hover:text-terminal-cyan">risunCode</a></p>
        </div>
    </footer>

    <script src="assets/js/matrix.js"></script>

    <script>
        async function loadDocs() {
            const loading = document.getElementById('loading-state');
            const error = document.getElementById('error-state');
            const container = document.getElementById('docs-container');
            const content = document.getElementById('markdown-content');
            const toc = document.getElementById('toc-nav');

            try {
                const res = await fetch('https://raw.githubusercontent.com/risunCode/SurfManager/refs/heads/main/README.md');
                if (!res.ok) throw new Error('Failed');
                const md = await res.text();
                content.innerHTML = convertMD(md);
                generateTOC(content, toc);
                loading.classList.add('hidden');
                container.classList.remove('hidden');
                setupScrollSpy();
            } catch (e) {
                loading.classList.add('hidden');
                error.classList.remove('hidden');
            }
        }

        function convertMD(md) {
            let html = md;
            html = html.replace(/```(\w+)?\n([\s\S]*?)```/g, (m, lang, code) => `<pre><code>${esc(code.trim())}</code></pre>`);
            html = html.replace(/!\[([^\]]*)\]\(([^\)]+)\)/g, '<img src="$2" alt="$1">');
            html = html.replace(/\[([^\]]+)\]\(([^\)]+)\)/g, '<a href="$2" target="_blank">$1</a>');
            html = html.replace(/^### (.+)$/gim, '<h3 id="$1">$1</h3>');
            html = html.replace(/^## (.+)$/gim, '<h2 id="$1">$1</h2>');
            html = html.replace(/^# (.+)$/gim, '<h1 id="$1">$1</h1>');
            html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
            html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
            html = html.replace(/^---$/gim, '<hr>');
            html = html.replace(/^\* (.+)$/gim, '<li>$1</li>');
            html = html.replace(/^- (.+)$/gim, '<li>$1</li>');
            html = html.replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>');
            html = html.split('\n\n').map(p => {
                p = p.trim();
                if (!p || p.startsWith('<')) return p;
                return `<p>${p}</p>`;
            }).join('\n');
            return html;
        }

        function esc(txt) {
            const div = document.createElement('div');
            div.textContent = txt;
            return div.innerHTML;
        }

        function generateTOC(content, toc) {
            const headers = content.querySelectorAll('h1, h2, h3');
            const items = [];
            headers.forEach((h, i) => {
                const level = h.tagName;
                const text = h.textContent;
                const id = `h-${i}`;
                h.id = id;
                const cls = level === 'H1' ? 'level-1' : level === 'H2' ? 'level-2' : 'level-3';
                items.push(`<a href="#${id}" class="${cls}" data-target="${id}">${text}</a>`);
            });
            toc.innerHTML = items.join('');
        }

        function setupScrollSpy() {
            const headers = document.querySelectorAll('#markdown-content h1, #markdown-content h2, #markdown-content h3');
            const links = document.querySelectorAll('#toc-nav a');

            window.addEventListener('scroll', () => {
                let current = '';
                headers.forEach(h => {
                    if (h.getBoundingClientRect().top <= 100) current = h.id;
                });
                links.forEach(link => {
                    link.classList.remove('active');
                    if (link.dataset.target === current) link.classList.add('active');
                });
            });

            links.forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    const target = document.getElementById(link.dataset.target);
                    if (target) window.scrollTo({ top: target.offsetTop - 80, behavior: 'smooth' });
                });
            });
        }

        window.addEventListener('load', loadDocs);
    </script>
</body>

</html>
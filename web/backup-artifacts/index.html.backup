    <!-- About Section -->
    <section id="about" class="min-h-screen py-20 px-4 border-t border-terminal-border">
        <div class="max-w-6xl mx-auto">
            <div class="mb-12">
                <h2 class="text-3xl md:text-5xl font-bold text-terminal-green terminal-text mb-4">
                    ❯ ABOUT_
                </h2>
                <p class="text-terminal-cyan">// What is SurfManager?</p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <!-- Main Description -->
                <div class="space-y-6">
                    <div class="border border-terminal-border p-6 bg-terminal-bg/30">
                        <h3 class="text-xl font-bold text-terminal-cyan mb-4">WHAT IS THIS?</h3>
                        <p class="text-terminal-gray leading-relaxed mb-4">
                            SurfManager is a powerful session and data management tool designed specifically for AI
                            coding applications.
                            It provides developers with complete control over their development environment data.
                        </p>
                        <p class="text-terminal-gray leading-relaxed">
                            Built with efficiency and safety in mind, SurfManager automates the tedious process of
                            backing up,
                            restoring, and managing application sessions - allowing you to focus on what matters:
                            coding.
                        </p>
                    </div>

                    <div class="border border-terminal-border p-6 bg-terminal-bg/30">
                        <h3 class="text-xl font-bold text-terminal-cyan mb-4">SUPPORTED APPLICATIONS</h3>
                        <div class="space-y-2 text-terminal-gray">
                            <p>✓ Cursor</p>
                            <p>✓ Windsurf</p>
                            <p>✓ Visual Studio Code</p>
                            <p>✓ All VSCode-based editors</p>
                            <p class="text-terminal-green mt-4">+ Easily add custom applications via JSON config</p>
                        </div>
                    </div>
                </div>

                <!-- Use Cases -->
                <div class="space-y-6">

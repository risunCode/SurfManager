<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SurfManager | Session & Data Management Tool</title>
    <meta name="description"
        content="Advanced session and data management tool for AI coding applications. Backup, restore, and manage your development environments with precision.">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom Tailwind Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        terminal: {
                            bg: '#0a0e27',
                            dark: '#050810',
                            border: '#1a1f3a',
                            green: '#00ff41',
                            cyan: '#00d4ff',
                            gray: '#8b949e',
                        }
                    },
                    fontFamily: {
                        mono: ['Courier New', 'monospace'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom animations */
        @keyframes blink {

            0%,
            50% {
                opacity: 1;
            }

            51%,
            100% {
                opacity: 0;
            }
        }

        .cursor-blink::after {
            content: '▋';
            animation: blink 1s infinite;
            color: #00ff41;
        }

        .scan-line {
            position: relative;
            overflow: hidden;
        }

        .scan-line::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #00ff41, transparent);
            animation: scan 3s linear infinite;
        }

        @keyframes scan {
            0% {
                left: -100%;
            }

            100% {
                left: 100%;
            }
        }

        .terminal-text {
            text-shadow: 0 0 5px rgba(0, 255, 65, 0.5);
        }

        .glow-border {
            box-shadow: 0 0 10px rgba(0, 255, 65, 0.3),
                0 0 20px rgba(0, 255, 65, 0.1);
        }

        .glow-border:hover {
            box-shadow: 0 0 15px rgba(0, 255, 65, 0.5),
                0 0 30px rgba(0, 255, 65, 0.2);
        }

        /* Scanline effect */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(0deg,
                    rgba(0, 0, 0, 0.15),
                    rgba(0, 0, 0, 0.15) 1px,
                    transparent 1px,
                    transparent 2px);
            pointer-events: none;
            z-index: 9999;
        }
    </style>
</head>

<body class="bg-terminal-dark text-terminal-gray font-mono antialiased">

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-terminal-bg/95 backdrop-blur-sm border-b border-terminal-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center space-x-3">
                    <span class="text-2xl text-terminal-green">❯</span>
                    <span class="text-xl font-bold text-terminal-green terminal-text">SURFMANAGER</span>
                    <span class="text-xs text-terminal-cyan border border-terminal-cyan px-2 py-1">v5.1.2</span>
                </div>

                <!-- Desktop Menu -->
